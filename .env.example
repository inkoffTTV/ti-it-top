BOT_TOKEN=
ADMIN_IDS=
# ADMIN_IDS — стартовые админы. Дополнительных админов можно добавить из Mini App → Админка → Администраторы.

DATABASE_URL=sqlite+aiosqlite:///./tournament.db
STEAM_API_KEY=
STRATZ_API_TOKEN=
STRATZ_API_URL=https://api.stratz.com/graphql
PROFILE_CACHE_TTL=1800
PROFILE_CACHE_PATH=profile_cache.json
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_ID=
HTTP_PROXY_URL=
HTTP_IMPERSONATE=chrome126

# Telegram Mini App (HTTPS URL required by Telegram in production)
MINIAPP_URL=
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8080

# Optional local-only Mini App development fallback (do not use in production)
MINIAPP_DEV_USER_ID=

# Если true — несовпадение exact MMR со справочным OpenDota rank_tier блокирует ввод. По умолчанию false.
MMR_RANK_RANGE_HARD_BLOCK=false

# Mini App AI assistant (admin-only, read-only DB tools)
# Recommended free setup: OpenRouter free router. It automatically selects a free model
# that supports the features requested by the call (including tool calling).
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=openrouter/free
# Второй бесплатный шанс на том же ключе OpenRouter.
AI_FALLBACK_MODEL=qwen/qwen3.8-27b:free
# Независимый резервный провайдер: Groq. Можно оставить пустым.
AI_BACKUP_API_KEY=
AI_BACKUP_BASE_URL=https://api.groq.com/openai/v1/chat/completions
AI_BACKUP_MODEL=openai/gpt-oss-120b
AI_MAX_TOOL_ROUNDS=5

# Альтернатива вместо OpenRouter: Gemini через Google AI Studio.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# AI_MODEL=gemini-3.8-flash
# AI_API_KEY=YOUR_GEMINI_API_KEY
